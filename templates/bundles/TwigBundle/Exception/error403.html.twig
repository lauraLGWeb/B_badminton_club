{% extends 'base.html.twig' %}

{% block title %}Accès refusé{% endblock %}

{% block body %}
<div style="text-align: center; padding: 50px; max-width: 600px; margin: 0 auto;">
    <h1 style="color: #e74c3c; font-size: 3em;">🚫 Accès refusé</h1>
    
    <p style="font-size: 1.5em; color: #555; margin: 30px 0;">
        Vous n'avez pas les permissions nécessaires pour accéder à cette page.
    </p>
    
    <p style="color: #888;">
        Cette page est réservée aux administrateurs du Blois Badminton Club.
    </p>
    
    <div style="margin-top: 40px;">
        <a href="{{ path('app_home') }}" 
           style="background: #3498db; color: white; padding: 15px 30px; 
                  text-decoration: none; border-radius: 5px; font-size: 1.2em;">
            ← Retour à l'accueil
        </a>
    </div>
    
    <p style="margin-top: 30px; color: #999; font-size: 0.9em;">
        Si vous pensez qu'il s'agit d'une erreur, contactez un administrateur.
    </p>
</div>
{% endblock %}

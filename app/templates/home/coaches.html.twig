{% extends 'base.html.twig' %}

{% block meta %}
    <meta 
        name="description" 
        content="Rencontrez les entraîneurs professionnels du Blois Badminton Club : Simon Paton et Tom. Découvrez leur rôle, leur formation et leur expertise pour accompagner les joueurs vers la performance." />
{% endblock %}

{% block title %}{{ 'Entraîneurs'|trans }}{% endblock %}

{% block body %}

<section class="coaches-team-section">
    <h1>{{ 'Nos Entraîneurs Professionnels'|trans }}</h1>
    
    <div class="coaches">
        <div class="coach-card">
            <div class="coach-header">
                <div class="coach-icon">🏸</div>
                <div class="coach-info">
                    <h3>Simon PATON</h3>
                    <p class="coach-position">{{ 'Éducateur sportif chargé du Club Avenir'|trans }}</p>
                </div>
            </div>
            
            <div class="coach-qualifications">
                <h4>{{ 'Formation'|trans }} :</h4>
                <ul>
                    <li>✅ {{ 'DEJEPS Perfectionnement Sportif mention Badminton'|trans }}</li>
                    <li>🎯 {{ 'En préparation du DESJEPS Performance Sportive mention Badminton'|trans }}</li>
                </ul>
            </div>
        </div>
        
        <div class="coach-card">
            <div class="coach-header">
                <div class="coach-icon">🏸</div>
                <div class="coach-info">
                    <h3>Tom ...</h3>
                    <p class="coach-position">{{ 'Agent de développement en charge de la performance sociale'|trans }}</p>
                </div>
            </div>
            
            <div class="coach-qualifications">
                <h4>{{ 'Formation'|trans }} :</h4>
                <ul>
                    <li>✅ {{ 'CQP Animateur de Badminton'|trans }}</li>
                    <li>✅ {{ 'DEJEPS Perfectionnement Sportif mention Badminton'|trans }}</li>
                </ul>
            </div>
        </div>
    </div>
</section>

{% endblock %}
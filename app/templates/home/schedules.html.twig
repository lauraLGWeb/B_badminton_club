{% extends 'base.html.twig' %}

{% block title %}{{ 'Créneaux'|trans }}{% endblock %}

{% block meta %}
    <meta 
        name="description" 
        content="Consultez les créneaux d'entraînement du Blois Badminton Club pour les adultes et les jeunes. Informations sur les gymnases, horaires et tarifs d'inscription." />
{% endblock %}

{% block body %}

<div class="creneaux-container">
    <h1>{{ 'Créneaux d\'entraînement'|trans }}</h1>

    {# Créneaux SENIORS #}
    <section class="planning-section">
        <h2 id="planningSenior">{{ 'Planning Seniors'|trans }}</h2>
        
        <div class="tarifs-container">
            <p>
                {{ 'Pour le Jeu libre tout public le Week End : Il faudra intégrer le groupe Whatsapp dédié. (il te suffit de nous le demander et nous t\'ajouterons !)'|trans }}<br>
                {{ 'En effet, l\'ouverture et la fermeture du gymnase se fait par des bénévoles du club.'|trans }}
            </p>

            <a href="{{ path('app_prices') }}" class="email-link">
                {{ 'Voir les tarifs d\'inscription'|trans }}
            </a>
        </div>

        <div class="table-responsive">
            <table class="planning-table">
                <thead>
                    <tr>
                        <th>{{ 'Horaires'|trans }}</th>
                        <th>{{ 'Lundi'|trans }}</th>
                        <th>{{ 'Mardi'|trans }}</th>
                        <th>{{ 'Mercredi'|trans }}</th>
                        <th>{{ 'Jeudi'|trans }}</th>
                        <th>{{ 'Vendredi'|trans }}</th>
                        <th>{{ 'Samedi'|trans }}</th>
                        <th>{{ 'Dimanche'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {# 10h00 - 12h00 #}
                    <tr>
                        <td class="time-cell">10h00-12h00</td>
                        <td colspan="6" class="empty-cell"></td>
                        <td class="rose">
                            <strong>{{ 'JEU LIBRE'|trans }}</strong><br>
                            {{ 'PARENTS / ENFANTS'|trans }}
                        </td>
                    </tr>

                    {# 14h - 18h #}
                    <tr>
                        <td class="time-cell">14h-18h</td>
                        <td colspan="5" class="empty-cell"></td>
                        <td class="bleu" rowspan="2">
                            <strong>{{ 'JEU LIBRE TOUT PUBLIC'|trans }}</strong><br>
                            // {{ 'CHALLENGES'|trans }}
                        </td>
                        <td></td>
                    </tr>

                    {# 18h - 18h30 #}
                    <tr>
                        <td class="time-cell">18h-18h30</td>
                        <td colspan="5" class="empty-cell"></td>
                        <td></td>
                    </tr>

                    {# 18h30 - 19h #}
                    <tr>
                        <td class="time-cell">18h30-19h</td>
                        <td></td>
                        <td></td>
                        <td class="bleu" rowspan="3">
                            <strong>{{ 'JEU LIBRE NON COMPÉTITEURS + GR ENSEIGNEMENT'|trans }}</strong><br>
                            <span class="location">SPa</span>
                        </td>
                        <td></td>
                        <td class="bleu-fonce" rowspan="2">
                            <strong>{{ 'JEU LIBRE'|trans }}</strong><br>
                            {{ 'GR ENTRAÎNEMENT 1 + 2'|trans }}
                        </td>
                        <td></td>
                        <td></td>
                    </tr>

                    {# 19h - 20h #}
                    <tr>
                        <td class="time-cell">19h-20h</td>
                        <td></td>
                        <td class="rouge-fonce" rowspan="3">
                            <strong>{{ 'ENTRAÎNEMENT GROUPE R+/N'|trans }}</strong><br>
                            <span class="location">SPa</span>
                        </td>
                        <td class="rouge-fonce" rowspan="3">
                            <strong>{{ 'ENTRAÎNEMENT GROUPE R+/N'|trans }}</strong><br>
                            <span class="location">SPa</span>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>

                    {# 20h - 20h15 #}
                    <tr>
                        <td class="time-cell">20h-20h15</td>
                        <td></td>
                        <td class="bleu" rowspan="4">
                            <strong>{{ 'JEU LIBRE NON COMPÉTITEURS'|trans }}</strong><br>
                            + {{ 'GR ENSEIGNEMENT'|trans }}
                        </td>
                        <td></td>
                        <td></td>
                    </tr>

                    {# 20h15 - 20h30 #}
                    <tr>
                        <td class="time-cell">20h15-20h30</td>
                        <td class="rouge-clair" rowspan="3">
                            <strong>{{ 'ENTRAÎNEMENT GR1 et GR2'|trans }}</strong><br>
                            <span class="location">SPa</span>
                        </td>
                        <td class="bleu" rowspan="3">
                            <strong>{{ 'JEU LIBRE NON COMPÉTITEURS + GR ENSEIGNEMENT'|trans }}</strong><br>
                            <span class="location">SPa</span>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>

                    {# 20h30 - 21h #}
                    <tr>
                        <td class="time-cell">20h30-21h</td>
                        <td class="gris" rowspan="2">
                            <strong>{{ 'ENSEIGNEMENT D8 / P11'|trans }}</strong><br>
                            <span class="location">TMa</span>
                        </td>
                        <td class="rouge-clair" rowspan="2">
                            <strong>{{ 'ENTRAÎNEMENT D8 / R'|trans }}</strong><br>
                            <span class="location">SPa</span>
                        </td>
                        <td></td>
                        <td></td>
                    </tr>

                    {# 21h - 22h #}
                    <tr>
                        <td class="time-cell">21h-22h</td>
                        <td></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    {# Créneaux JEUNES #}
    <section class="planning-section">
        <h2>{{ 'Planning Jeunes'|trans }}</h2>

        <div class="tarifs-container">
            <h3>{{ 'CATEGORIES'|trans }}</h3>
            <table>
                <tr>
                    <th>{{ 'Catégorie'|trans }}</th>
                    <th>{{ 'Année de naissance'|trans }}</th>
                </tr>
                <tr>
                    <td>{{ 'Minibad'|trans }}</td>
                    <td>{{ 'Né en 2018 ou après'|trans }}</td>
                </tr>
                <tr>
                    <td>{{ 'Poussin'|trans }}</td>
                    <td>{{ 'Né en 2016 et 2017'|trans }}</td>
                </tr>
                <tr>
                    <td>{{ 'Benjamin'|trans }}</td>
                    <td>{{ 'Né en 2014 et 2015'|trans }}</td>
                </tr>
                <tr>
                    <td>{{ 'Minime'|trans }}</td>
                    <td>{{ 'Né en 2012 et 2013'|trans }}</td>
                </tr>
                <tr>
                    <td>{{ 'Cadet'|trans }}</td>
                    <td>{{ 'Né en 2010 et 2011'|trans }}</td>
                </tr>
                <tr>
                    <td>{{ 'Junior*'|trans }}</td>
                    <td>{{ 'Né en 2008 et 2009'|trans }}</td>
                </tr>
            </table>
            <p>{{ '*Les juniors s\'entraînent et vont au jeu libre avec les adultes'|trans }} <a href="#planningSenior">({{ 'cf. créneaux adultes'|trans }}).</a></p>

            <a href="{{ path('app_prices') }}" class="email-link">
                {{ 'Voir les tarifs d\'inscription'|trans }}
            </a>
        </div>

        <img src="pictures/planningJeunes.png" alt="{{ 'Planning jeunes'|trans }}">
    </section>
</div>

<section class="planning-section">
    <h2>{{ 'Les gymnases'|trans }}</h2>
    <section class="coaches">
        <div class="coach-card">
            <div class="coach-header">
                <h3>{{ 'Gymnase François Rabelais'|trans }}</h3>
                <p class="coach-position">{{ 'Le club dispose de 7 terrains. Les terrains sont disponibles sur les créneaux indiqués ci-dessus.'|trans }}</p>
            </div>
            
            <div class="coach-qualifications">
                <h4>{{ 'Equipements'|trans }} :</h4>
                <ul>
                    <li>{{ 'Vestiaires et douches'|trans }}</li>
                    <li>{{ 'Parking gratuit'|trans }}</li>
                </ul>
            </div>
            <a class="location" href="https://maps.app.goo.gl/zgVd9cG8kY91rZ2J6">
                {{ 'Gymnase François Rabelais, Rue Buffon, 41000 Blois'|trans }}
            </a>
        </div>

        <div class="coach-card">
            <div class="coach-header">
                <h3>{{ 'Gymnase Raymond Etelin'|trans }}</h3>
                <p class="coach-position">{{ 'Le club dispose de 7 terrains. Les terrains sont disponibles sur les créneaux indiqués ci-dessus.'|trans }}</p>
            </div>
            
            <div class="coach-qualifications">
                <h4>{{ 'Equipements'|trans }} :</h4>
                <ul>
                    <li>{{ 'Vestiaires et douches'|trans }}</li>
                    <li>{{ 'Parking gratuit'|trans }}</li>
                </ul>
            </div>
            <a class="location" href="https://maps.app.goo.gl/aHDV1HosYoR1hP3p9">
                {{ 'Gymnase Raymond Etelin, 22 rue des papillons, 41000 Blois'|trans }}
            </a>
        </div>
    </section>
</section>

{% endblock %}
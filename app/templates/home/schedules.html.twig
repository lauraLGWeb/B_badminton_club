{% extends 'base.html.twig' %}

{% block title %}{{ 'Créneaux'|trans }}{% endblock %}

{% block meta %}
    <meta 
        name="description" 
        content="Consultez les créneaux d'entraînement du Blois Badminton Club pour les adultes et les jeunes. Informations sur les gymnases, horaires et tarifs d'inscription." />
{% endblock %}

{% block body %}

<div class="creneaux-container">
    <h1>{{ 'Créneaux d\'entraînement'|trans }}</h1>

    {# Créneaux SENIORS #}
    <section class="planning-section">
        <h2 id="planningSenior">{{ 'Planning Seniors'|trans }}</h2>
        
        <div class="tarifs-container">
            <p>
                {{ 'Pour le Jeu libre tout public le Week End : Il faudra intégrer le groupe Whatsapp dédié. (il te suffit de nous le demander et nous t\'ajouterons !)'|trans }}<br>
                {{ 'En effet, l\'ouverture et la fermeture du gymnase se fait par des bénévoles du club.'|trans }}
            </p>

            <a href="{{ path('app_prices') }}" class="email-link">
                {{ 'Voir les tarifs d\'inscription'|trans }}
            </a>
        </div>

        <div class="planning-img-scroll">
            <img src="{{ asset('pictures/planningSeniors.png') }}" alt="{{ 'Planning seniors'|trans }}">
        </div>
    </section>

    {# Créneaux JEUNES #}
    <section class="planning-section">
        <h2>{{ 'Planning Jeunes'|trans }}</h2>

        <div class="tarifs-container">
            <h3>{{ 'CATEGORIES'|trans }}</h3>
            <table class="categorieTable">
                <tr class="categorieTableFirst">
                    <th>{{ 'Catégorie'|trans }}</th>
                    <th>{{ 'Année de naissance'|trans }}</th>
                </tr>
                <tr>
                    <td>{{ 'Minibad'|trans }}</td>
                    <td>{{ 'Né en 2018 ou après'|trans }}</td>
                </tr>
                <tr>
                    <td>{{ 'Poussin'|trans }}</td>
                    <td>{{ 'Né en 2016 et 2017'|trans }}</td>
                </tr>
                <tr>
                    <td>{{ 'Benjamin'|trans }}</td>
                    <td>{{ 'Né en 2014 et 2015'|trans }}</td>
                </tr>
                <tr>
                    <td>{{ 'Minime'|trans }}</td>
                    <td>{{ 'Né en 2012 et 2013'|trans }}</td>
                </tr>
                <tr>
                    <td>{{ 'Cadet'|trans }}</td>
                    <td>{{ 'Né en 2010 et 2011'|trans }}</td>
                </tr>
                <tr>
                    <td>{{ 'Junior*'|trans }}</td>
                    <td>{{ 'Né en 2008 et 2009'|trans }}</td>
                </tr>
            </table>
            <p>{{ '*Les juniors s\'entraînent et vont au jeu libre avec les adultes'|trans }} ({{ 'cf. créneaux adultes'|trans }}).</a></p>

            <a href="{{ path('app_prices') }}" class="email-link">
                {{ 'Voir les tarifs d\'inscription'|trans }}
            </a>
        </div>

        <div class="planning-img-scroll">
            <img src="{{ asset('pictures/planningJeunes.png') }}" alt="{{ 'Planning jeunes'|trans }}">
        </div>
    </section>
</div>

<section class="planning-section">
    <h2>{{ 'Les gymnases'|trans }}</h2>
    <section class="coaches">
        <div class="coach-card">
            <div class="coach-header">
                <h3>{{ 'Gymnase François Rabelais'|trans }}</h3>
                <p class="coach-position">{{ 'Le club dispose de 7 terrains. Les terrains sont disponibles sur les créneaux indiqués ci-dessus.'|trans }}</p>
            </div>
            
            <div class="coach-qualifications">
                <h4>{{ 'Equipements'|trans }} :</h4>
                <ul>
                    <li>{{ 'Vestiaires et douches'|trans }}</li>
                    <li>{{ 'Parking gratuit'|trans }}</li>
                </ul>
            </div>
            <a class="location" href="https://maps.app.goo.gl/zgVd9cG8kY91rZ2J6">
                {{ 'Gymnase François Rabelais, Rue Buffon, 41000 Blois'|trans }}
            </a>
        </div>

        <div class="coach-card">
            <div class="coach-header">
                <h3>{{ 'Gymnase Raymond Etelin'|trans }}</h3>
                <p class="coach-position">{{ 'Le club dispose de 7 terrains. Les terrains sont disponibles sur les créneaux indiqués ci-dessus.'|trans }}</p>
            </div>
            
            <div class="coach-qualifications">
                <h4>{{ 'Equipements'|trans }} :</h4>
                <ul>
                    <li>{{ 'Vestiaires et douches'|trans }}</li>
                    <li>{{ 'Parking gratuit'|trans }}</li>
                </ul>
            </div>
            <a class="location" href="https://maps.app.goo.gl/aHDV1HosYoR1hP3p9">
                {{ 'Gymnase Raymond Etelin, 22 rue des papillons, 41000 Blois'|trans }}
            </a>
        </div>
    </section>
</section>

{% endblock %}
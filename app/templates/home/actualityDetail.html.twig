{% extends 'base.html.twig' %}

{% block meta %}
    <meta 
        name="description" 
        content="Découvrez {{ actuality.title }} au Blois Badminton Club. Événement prévu le {{ actuality.eventOn|date('d/m/Y') }}. Restez informé de toutes nos actualités et événements badminton à Blois." />
{% endblock %}

{% block title %}{{ 'Actualités'|trans }}{% endblock %}

{% block body %}

<section class="actuality-detail-section">
    <a href="{{ path('app_actuality') }}" role="button" class="btn-back">
        {{ 'Retour aux actualités'|trans }}
    </a>

    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_modifyActuality', {'id': actuality.id}) }}" class="btn-actuality">
            {{ 'Modifier'|trans }} →
        </a>
    {% endif %}
   
    <article class="actuality-detail-card">
        <h1 id="top">{{ actuality.title }}</h1>
        
        <div class="actuality-image-container">
            <img src="{{ actuality.picture }}" alt="{{ actuality.title }}" width="150px">
        </div>

        <div class="actuality-dates-detail">
            <div class="date-badge">
                <span class="date-badge-label">{{ 'Date de l\'événement'|trans }}</span>
                <span class="date-badge-value">{{ actuality.eventOn|date('d/m/Y') }}</span>
            </div>
    
            <div class="date-badge">
                <span class="date-badge-label">{{ 'Publié le'|trans }}</span>
                <span class="date-badge-value">{{ actuality.createdAt|date('d/m/Y') }}</span>
            </div>
        </div>

        <div class="actuality-description">
            <p>{{ actuality.description }}</p>
        </div>
    </article>
</section>

{% endblock %}
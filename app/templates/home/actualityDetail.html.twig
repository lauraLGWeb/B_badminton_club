{% extends 'base.html.twig' %}

{% block title %}Actualités{% endblock %}

{% block body %}

<h1>Actualités du club</h1>

<a href="{{ path('app_actuality')}}" role="button">Retour aux actualités</a>

    <section>
        
            <article style="border:1px solid #ddd; padding:10px; margin-bottom:15px; border-radius:8px;">
                <h2>{{ actuality.title }}</h2>
                <img src="{{ asset(actuality.picture) }}" alt="{{ actuality.title }}" width="150px">
                <p>{{ actuality.description }}</p>
                <p><strong> Cet évenement se tiendra le :</strong> {{ actuality.eventOn|date('d/m/Y H:i') }}</p>
                <p><strong>Créé le :</strong> {{ actuality.createdAt|date('d/m/Y') }}</p>
                
            </article>
       
    </section>

{% endblock %}

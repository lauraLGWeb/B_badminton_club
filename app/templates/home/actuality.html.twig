{% extends 'base.html.twig' %}

{% block title %}{{ 'Actualités'|trans }}{% endblock %}

{% block body %}

<section class="actualities-section">
    <h1 id="top">{{ 'Actualités du club'|trans }}</h1>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-{{ type }}">
                {{ message|trans }}
            </div>
        {% endfor %}
    {% endfor %}

    {% if actualities is empty %}
        <div class="no-actuality">
            <p>{{ 'Aucune actualité pour le moment.'|trans }}</p>
        </div>
    {% else %}
        <div class="actualities-grid">
            {% for actu in actualities %}
                <article class="actuality-card">
                    <img src="{{ asset(actu.picture) }}" alt="{{ actu.title|trans }}">
                    
                    <h2>{{ actu.title|trans }}</h2>
                    
                    <div class="actuality-dates">
                        <div class="actuality-date">
                            <strong>📅 {{ 'Événement'|trans }} :</strong> {{ actu.eventOn|date('d/m/Y') }}
                        </div>
                        <div class="actuality-date">
                            <strong>🕐 {{ 'Créé le'|trans }} :</strong> {{ actu.createdAt|date('d/m/Y') }}
                        </div>
                    </div>
                    
                    <p>{{ actu.description|trans }}</p>
                    
                    <a href="{{ path('app_actualityDetail', {'id': actu.id}) }}" class="btn-actuality">
                        {{ 'En savoir plus'|trans }} →
                    </a>
                   
                    {% if is_granted('ROLE_ADMIN') %}
                        <form class="actuForm" 
                              action="{{ path('app_deleteActuality', {'id': actu.id}) }}" 
                              method="post" 
                              onsubmit="return confirm('{{ 'Supprimer cet article ?'|trans }}')">
                            <input type="hidden" 
                                   name="_token" 
                                   value="{{ csrf_token('delete_actuality_' ~ actu.id) }}">
                            <button type="submit" class="btn-actuality">
                                {{ 'Supprimer'|trans }} →
                            </button>
                        </form>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    {% endif %}
</section>

{% endblock %}
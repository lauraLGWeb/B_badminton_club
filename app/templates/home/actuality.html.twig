{% extends 'base.html.twig' %}

{% block title %}Actualités{% endblock %}

{% block body %}

<h1>Actualités du club</h1>

{% if actualities is empty %}
    <p>Aucune actualité pour le moment.</p>
{% else %}
    <section>
        {% for actu in actualities %}
            <article style="border:1px solid #ddd; padding:10px; margin-bottom:15px; border-radius:8px;">
                <h2>{{ actu.title }}</h2>
                {% if actu.picture %}
                    <img src="{{ actu.picture }}" alt="{{ actu.title }}" width="150px">
                {% endif %}
                <p><strong>Événement le :</strong> {{ actu.eventOn|date('d/m/Y') }}</p>
                <p><strong>Créé le :</strong> {{ actu.createdAt|date('d/m/Y H:i') }}</p>
                <a href="{{ path('app_actualityDetail', {'id': actu.id}) }}" role="button">En savoir plus</a>

            </article>
        {% endfor %}
    </section>
{% endif %}

{% endblock %}

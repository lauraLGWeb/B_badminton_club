{% extends 'base.html.twig' %}

{% block title %}Actualités{% endblock %}

{% block body %}

<section class="actualities-section">
    <h1> Actualités du club</h1>

    {% if actualities is empty %}
        <div class="no-actuality">
            <p>Aucune actualité pour le moment.</p>
        </div>
    {% else %}
        <div class="actualities-grid">
            {% for actu in actualities %}
                <article class="actuality-card">
                    <img src="{{ asset(actu.picture) }}" alt="{{ actu.title }}">
                    
                    <h2>{{ actu.title }}</h2>
                    
                    <div class="actuality-dates">
                        <div class="actuality-date">
                            <strong>📅 Événement :</strong> {{ actu.eventOn|date('d/m/Y') }}
                        </div>
                        <div class="actuality-date">
                            <strong>🕐 Créé le :</strong> {{ actu.createdAt|date('d/m/Y') }}
                        </div>
                    </div>
                    
                    <p>{{ actu.description }}</p>
                    
                    <a href="{{ path('app_actualityDetail', {'id': actu.id}) }}" class="btn-actuality">
                        En savoir plus →
                    </a>
                   
                    {% if is_granted('ROLE_ADMIN')%}
                         <a href="{{ path('app_deleteActuality', {'id': actu.id}) }}" class="btn-actuality">
                        supprimer  →
                         </a>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    {% endif %}
</section>

{% endblock %}
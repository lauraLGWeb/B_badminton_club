    </section>

    {# CA #}
    <section class="board-members-section">
        <h2> Le Conseil d'Administration</h2>
        
        <div class="volunteer-call">
            <p>
                Le club est continuellement à la recherche de <strong>bénévoles</strong> pour 
                étoffer son Comité d'Administration et l'aider au quotidien à son bon fonctionnement.
            </p>
            <a href="{{ path('app_contact') }}" class="volunteer-btn">Rejoindre l'équipe en nous contactant</a>

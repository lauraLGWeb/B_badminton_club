{% extends 'base.html.twig' %}

{% block title %}Membres du CA{% endblock %}


{% block body %}

<div class="team-container">
    <h1>L'équipe du Blois Badminton Club</h1>
    
    {# members #}
    <section class="board-section">
        <h2> Le Bureau - Saison 2024-2025</h2>
        
        <div class="members">
            <div class="member-card president">
                <div class="member-icon">👤</div>
                <h3>Mélanie PETEL</h3>
                <p class="member-role">Présidente</p>
            </div>
            
            <div class="member-card">
                <div class="member-icon">👤</div>

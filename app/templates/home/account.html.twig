{% extends 'base.html.twig' %}

{% block title %}Mon compte{% endblock %}




{% block body %}
{% if app.user %}
        <h1 id="top"> Bonjour {{app.user.firstName}} {{app.user.lastName}} ! Nous sommes ravis de te revoir !</h1>
       
    <section class="accountSection">
        <span class="span-account"> Si tu souhaite modifier une information de ton compte, dis-le nous par  </span> <a class="mail-account" href="mailto:bloisbadclub@gmail.com">mail</a> <span class="span-account">, nous effectuerons la modification.</span>

        <p class="span-account">Petit rappel si besoin, ton numéro de licence est le {{app.user.lienceNbr}} </p>
        
        <div>
            <a class="newLicence" href="https://www.myffbad.fr/connexion" target=blank >Renouveller mon inscription</a>
        </div>
    </section>
{% endif %}

       
<h2> Mes commandes: </h2>


{% for order in orders %}
<section class="ordersContainer">

    <div class="ordersDiv">
        <h3>Commande numéro : {{ order.id }}</h3>
        <p>Date : {{ order.purchaseDate|date('d/m/Y H:i') }}</p>
        
        <h4>Articles :</h4>
        <div>
            {% for item in order.cartItem %}
                <p>{{ item.product.title }}  {{ item.size }}  {{ item.gender }} (x{{ item.quantity }})</p>
            {% endfor %}
        </div>
    </div>
</section>

{% endfor %}
    {% if orders is empty %}
            <div class="no-actuality">
                <p>Aucune commande pour le moment.</p>
            </div>
    {% endif %}

{% endblock %}


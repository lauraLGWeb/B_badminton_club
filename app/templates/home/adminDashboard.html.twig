{% extends 'base.html.twig' %}

{% block meta %}
    <meta 
        name="description" 
        content="Tableau de bord administrateur du Blois Badminton Club : gestion des membres, stages, boutique et actualités pour les utilisateurs avec le rôle admin." />
{% endblock %}

{% block title %}{{ 'Tableau de bord Admin'|trans }}{% endblock %}

{% block body %}

<div class="admin-dashboard">
    <h id="top">{{ 'Tableau de bord'|trans }}</h


        <ul>
            {% if is_granted('ROLE_ADMIN')%}
                <li>
                    <a data-bs-toggle="collapse" href="#membersMenu">
                        👥 {{ 'Membres'|trans }}
                    </a>
                    <div class="collapse" id="membersMenu">
                        <ul>
                            <li>
                                <a href="{{ path('app_membersList') }}">
                                    {{ 'Liste des membres'|trans }}
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
            {% endif %}

            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ENTRAINEUR')%}
                        <li>
                            <a data-bs-toggle="collapse" href="#internshipsMenu">
                                🏸 {{ 'Stages'|trans }}
                            </a>
                            <div class="collapse" id="internshipsMenu">
                                <ul>
                                    <li>
                                        <a href="{{ path('app_internships') }}">
                                            {{ 'Liste des stages'|trans }}
                                        </a>
                                    </li>
                                    <li>
                                        <a href="{{ path('app_createInternship') }}">
                                            ➕ {{ 'Créer un stage'|trans }}
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </li>
            {% endif %}
            
            {% if is_granted('ROLE_ADMIN') %}
                <li>
                    <a data-bs-toggle="collapse" href="#shopMenu">
                        🛒 {{ 'Boutique'|trans }}
                    </a>
                    <div class="collapse" id="shopMenu">
                        <ul>
                            <li>
                                <a href="{{ path('app_ItemsList') }}">
                                    {{ 'Produits'|trans }}
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('app_AddItemsList') }}">
                                    ➕ {{ 'Ajouter un produit'|trans }}
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('app_orders') }}">
                                    {{ 'Commandes'|trans }}
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
            {% endif %}

            {% if is_granted('ROLE_ADMIN') %}
                <li>
                    <a data-bs-toggle="collapse" href="#newsMenu">
                        📰 {{ 'Actualités'|trans }}
                    </a>
                    <div class="collapse" id="newsMenu">
                        <ul>
                            <li>
                                <a href="{{ path('app_actuality') }}">
                                    {{ 'Liste des actus'|trans }}
                                </a>
                            </li>
                            <li>
                                <a href="{{ path('app_createActuality') }}">
                                    ➕ {{ 'Publier une actualité'|trans }}
                                </a>
                            </li>
                        </ul>
                    </div>
                </li>
            {% endif %}
            <li>
                <a href="{{ path('app_home') }}">
                    ← {{ 'Retour au site'|trans }}
                </a>
            </li>
        </ul>
</div>

{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Tableau de bord Admin{% endblock %}

{% block body %}
     
        <div class="admin-dashboard">
                           <h1 id="top">Tableau de bord </h1>
                      
                    {# members #}
                    {% if is_granted('ROLE_ADMIN')%}
                    <ul>
                        <li>
                            <a data-bs-toggle="collapse" href="#membersMenu"> 👥 Membres 
                            </a>
                            <div class="collapse" id="membersMenu">
                                <ul >
                                    <li><a href="{{ path('app_membersList') }}">Liste des membres</a>
                                    </li>
                                </ul>
                            </div>
                        </li>
                    {% endif %}
                    
                         {# coatch #}
                        <li>
                            <a data-bs-toggle="collapse" href="#internshipsMenu">🏸 Stages </a>
                            <div class="collapse" id="internshipsMenu">
                                <ul>
                                    <li><a href="{{ path('app_internships') }}">Liste des stages</a></li>
                                    <li><a href="{{ path('app_home') }}">➕ Créer un stage</a></li>
                                </ul>
                            </div>
                          </li>
                    
                    {# admin shop #}
                        {% if is_granted('ROLE_ADMIN')%}
                        <li >
                            <a data-bs-toggle="collapse" href="#shopMenu"> 🛒 Boutique </a>
                            <div class="collapse" id="shopMenu">
                                <ul >
                                    <li><a href="{{ path('app_ItemsList') }}" >Produits</a></li>
                                    <li><a href="{{ path('app_AddItemsList') }}">➕ Ajouter un produit</a></li>
                                    <li><a href="{{ path('app_orders') }}">Commandes</a></li>
                                   
                                </ul>
                            </div>
                        </li>
                        {% endif %}
                    
                        {# actu admin #}
                        {% if is_granted('ROLE_ADMIN')%}
                        <li >
                            <a data-bs-toggle="collapse" href="#newsMenu">📰 Actualités</a>
                            <div class="collapse" id="newsMenu">
                                <ul>
                                    <li><a href="{{ path('app_actuality') }}" >Liste des actus</a></li>
                                    <li><a href="{{ path('app_createActuality') }}" >➕ Publier une actualité</a></li>
                                </ul>
                            </div>
                        </li>
                        {% endif %}
                    
                        <li >
                            <a  href="{{ path('app_home') }}">
                                ← Retour au site
                            </a>
                        </li>
                </ul>
            </div>
       </div>
{% endblock %}





{% extends 'base.html.twig' %}

{% block title %}Tableau de bord Admin{% endblock %}

{% block body %}
     
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <div>
                <h1 >Tableau de bord</h1>
            </div>
            
            {# Gestion Membres #}
                    {% if is_granted('ROLE_ADMIN')%}
                    <li>
                        <a data-bs-toggle="collapse" href="#membersMenu"> 👥 Membres </a>
                            <div class="collapse" id="membersMenu">
                                <ul >
                                    <li><a href="{{ path('app_membersList') }}">Liste des membres</a></li>
                                </ul>
                            </div>
                    </li>
                     {% endif %}
                    
                    {# Gestion Stages #}
                    <li>
                        <a data-bs-toggle="collapse" href="#internshipsMenu">🏸 Stages </a>
                        <div class="collapse" id="membersMenu">
                            <ul>
                                <li><a href="{{ path('app_home') }}" >Liste des stages</a></li>
                                <li><a href="{{ path('app_home') }}">➕ Créer un stage</a></li>
                            </ul>
                        </div>
                    </li>
                    
                    {# Gestion Boutique #}
                    {% if is_granted('ROLE_ADMIN')%}
                    <li >
                        <a data-bs-toggle="collapse" href="#shopMenu"> 🛒 Boutique </a>
                        <div class="collapse" id="shopMenu">
                            <ul >
                                <li><a href="{{ path('app_home') }}" >Produits</a></li>
                                <li><a href="{{ path('app_home') }}">➕ Ajouter un produit</a></li>
                                <li><a href="{{ path('app_home') }}">Commandes</a></li>
                                <li><a href="{{ path('app_home') }}">Stock</a></li>
                            </ul>
                        </div>
                    </li>
                    {% endif %}
                    
                    {# Gestion Actualités #}
                     {% if is_granted('ROLE_ADMIN')%}
                    <li >
                        <a data-bs-toggle="collapse" href="#newsMenu">📰 Actualités</a>
                        <div class="collapse" id="newsMenu">
                            <ul>
                                <li><a href="{{ path('app_home') }}" >Liste des actus</a></li>
                                <li><a href="{{ path('app_home') }}" >➕ Publier une actualité</a></li>
                            </ul>
                        </div>
                    </li>
                    {% endif %}
                    {# Retour au site #}
                    <li >
                        <a  href="{{ path('app_home') }}">
                            ← Retour au site
                        </a>
                    </li>
                </ul>
            </div>
        </main>
{% endblock %}





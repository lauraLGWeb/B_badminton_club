{% extends 'base.html.twig' %}

{% block meta %}
    <meta 
        name="description" 
        content="Blois Badminton Club : club convivial et ambitieux avec 165 licenciés, école 4 étoiles, équipes jusqu’en Nationale 3 et encadrement professionnel. Rejoignez-nous !" />
{% endblock %}

{% block welcomingMessage %}
    <h1 class="firstTitle">
        {{ 'Bienvenue au Blois Badminton Club'|trans }}
        {% if app.user %}
            {{ app.user.firstName }}
        {% endif %}! 🏸
    </h1>
{% endblock %}

{% block body %}

<section class="clubPresentation">
    <p class="intro-text">
        {{ 'Depuis sa création, le club ne cesse de grandir grâce à l\'engagement de ses bénévoles et à la passion de ses'|trans }}
        <strong>{{ 'deux entraîneurs salariés'|trans }}</strong>. 
        {{ 'Une aventure collective tournée vers l\'excellence et le plaisir de jouer !'|trans }}
    </p>

    <div class="key-numbers">
        <div class="number-card">
            <span class="number">165</span>
            <span class="label">{{ 'licenciés'|trans }}</span>
        </div>
        <div class="number-card">
            <span class="number">75</span>
            <span class="label">{{ 'jeunes'|trans }}</span>
        </div>
        <div class="number-card">
            <span class="number">8</span>
            <span class="label">{{ 'équipes engagées'|trans }}</span>
        </div>
        <div class="number-card">
            <span class="number">⭐⭐⭐⭐</span>
            <span class="label">{{ 'École de Bad'|trans }}</span>
        </div>
    </div>

    <div class="coaches-section">
        <h2>👥 {{ 'Encadrement Professionnel'|trans }}</h2>
        <p>
            {{ 'Le BBC s\'appuie sur'|trans }} <strong>{{ 'deux entraîneurs salariés'|trans }}</strong> 
            {{ 'pour garantir un encadrement de qualité : Simon'|trans }} <strong>{{ 'juin 2019'|trans }}</strong>, 
            {{ 'rejoint par Tom en'|trans }} <strong>2022</strong> 
            {{ 'pour accompagner le développement du club vers le haut niveau. Une expertise au service de tous les licenciés, du loisir à la compétition !'|trans }}
        </p>
    </div>

    <div class="highlights">
        <div class="highlight-card">
            <h2>🏆 {{ 'Excellence Sportive'|trans }}</h2>
            <p>
                {{ 'Pour la première fois de son histoire, le BBC évolue en'|trans }} 
                <strong>{{ 'Nationale 3'|trans }}</strong> {{ 'cette saison ! Une fierté collective qui récompense des années de travail et d\'investissement de nos entraîneurs et joueurs.'|trans }}
            </p>
        </div>

        <div class="highlight-card">
            <h2>🎓 {{ 'Formation de Qualité'|trans }}</h2>
            <p>
                {{ 'Notre École Française de Badminton'|trans }} <strong>{{ '4 étoiles'|trans }}</strong> 
                {{ 'fait partie des 26 clubs d\'élite en France. En partenariat avec la ville de Blois, nous proposons également des'|trans }} 
                <strong>{{ 'Classes à Horaires Aménagés'|trans }}</strong> 
                {{ 'pour 15 collégiens passionnés.'|trans }}
            </p>
        </div>

        <div class="highlight-card">
            <h2 class="noAround">🌟 {{ 'Label Club Avenir'|trans }}</h2>
            <p>
                {{ 'Reconnu pour la qualité de son encadrement professionnel et sa structuration, le BBC porte depuis 2021 le prestigieux'|trans }} 
                <strong>{{ 'Label Club Avenir'|trans }}</strong>, 
                {{ 'gage de notre engagement vers le haut niveau.'|trans }}
            </p>
        </div>
    </div>

    <p class="transition-text">
        {{ 'Derrière ces chiffres et ces labels, ce sont avant tout des femmes et des hommes engagés qui font vivre le club au quotidien. Découvrez le mot de notre présidente...'|trans }}
    </p>
</section>

<section class="presentation">
    <img src="{{ asset('pictures/logo.jpeg') }}" alt="{{ 'femme jouant au badminton'|trans }}">
    <p>{{ 'Que vous soyez débutant, joueur confirmé ou simplement curieux de découvrir le badminton, notre club vous accueille dans une ambiance conviviale et chaleureuse, où le plaisir de jouer et le partage sont au cœur de nos valeurs.'|trans }}</p>

    <p>{{ 'En loisir comme en compétition, chacun trouve sa place au sein du club. Je vous invite à venir nous rencontrer, échanger quelques volants et partager de bons moments sportifs avec nous.'|trans }}</p>

    <p class="signature"><span>{{ 'La Présidente – Blois Badminton Club'|trans }}</span></p>
</section>

<section class="picture-main">
    <img src="{{ asset('pictures/main2.jpg') }}" alt="{{ 'joueuse de badminton'|trans }}">
</section>

<section class="main-presentation">
    <div class="reverse-div">
        <img src="{{ asset('pictures/loisir.png') }}" alt="{{ 'joueur loisir de badminton'|trans }}" class="img-1">
        <p>{{ 'Du loisir à la compétition, chacun trouve sa place au Blois Badminton Club !'|trans }}</p>
    </div>
    <div>
        <img src="{{ asset('pictures/entraineur.png') }}" alt="{{ 'entraineur de badminton'|trans }}">
        <p>{{ 'Formation de qualité pour nos jeunes, encadrés par des entraîneurs passionnés et diplômés.'|trans }}</p>
    </div>
    <div class="reverse-div">
        <img src="{{ asset('pictures/competition.png') }}" alt="{{ 'compétition de badminton avec t-shirt à l\'éffigie du club'|trans }}">
        <p>{{ 'Des équipes compétitives, de la départementale à la Nationale : progressez et dépassez-vous !'|trans }}</p>
    </div>
    <div>
        <img src="{{ asset('pictures/conviviale.png') }}" alt="{{ 'buvette conviviale pendant un tournois'|trans }}">
        <p>{{ 'Une ambiance conviviale et des bénévoles engagés : rejoignez notre famille sportive !'|trans }}</p>
    </div>
</section>

<section class="actu-section">
    <div class="triangle"></div>
    <h2>{{ 'Dernières actualités'|trans }}</h2>

    <section class="actus">
        <div class="actus-in-main">
            {% for actuality in actualities %}
                <article class="actu-main">
                    <img src="{{ asset(actuality.picture) }}" alt="{{ actuality.title }}">
                    
                    <h3>{{ actuality.title }}</h3>
                    
                    <div>
                        <div>
                            <strong>📅 {{ 'Événement'|trans }} :</strong> {{ actuality.eventOn|date('d/m/Y') }}
                        </div>
                        <div>
                            <strong>🕐 {{ 'Créé le'|trans }} :</strong> {{ actuality.createdAt|date('d/m/Y') }}
                        </div>
                    </div>
                    
                    <p>{{ actuality.description }}</p>
                    
                    <a href="{{ path('app_actualityDetail', {'id': actuality.id}) }}">
                        {{ 'En savoir plus'|trans }} →
                    </a>
                
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_deleteActuality', {'id': actuality.id}) }}">
                            {{ 'Supprimer'|trans }} →
                        </a>
                    {% endif %}
                </article>
            {% endfor %}
        </div>

        <div class="fb-page" 
            data-href="https://www.facebook.com/BloisBadmintonClub" 
            data-tabs="timeline" 
            data-width="1200"
            data-heigth="500" 
            data-small-header="true" 
            data-adapt-container-width="true" 
            data-hide-cover="false" 
            data-show-facepile="true">
        </div>
    </section>
</section>

<div>
    <a class="actu-btn" href="{{ path('app_actuality') }}">{{ 'Voir toutes les actualités'|trans }}</a>
</div>


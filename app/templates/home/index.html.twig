{% extends 'base.html.twig' %}

{% block title %}Accueil - Blois Badminton Club{% endblock %}


{% block logoContainer %}
    <section class="logoAndBtnContainer d-flex justify-content-between align-items-center px-3 py-2 bg-light">
        <a href="{{ path('app_home') }}">
            <img src="{{ asset('pictures/logo.jpeg') }}" width="150px" alt="logo">
        </a>
        
    
        <button class="btn btn-outline-secondary">EN / Mode</button>
    </section>
{% endblock %}


{% block body %}
<div class="container my-5">
    <h1>Bienvenue au Blois Badminton Club ! 🏸</h1>
    <section class="WelcomingMsgContainer">
            <img src="{{ asset('pictures/fente.jpg') }}" width="400px" alt="joueur de badminton">
    </section>

</div>
{% endblock %}
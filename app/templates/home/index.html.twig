{% extends 'base.html.twig' %}

{% block meta %}
    <meta 
        name="description" 
        content="Blois Badminton Club : club convivial et ambitieux avec 165 licenciés, école 4 étoiles, équipes jusqu'en Nationale 3 et encadrement professionnel. Rejoignez-nous !" />
{% endblock %}

{% block welcomingMessage %}
    <h1 class="firstTitle">
        {{ 'Bienvenue au Blois Badminton Club'|trans }}
        {% if app.user %}
            {{ app.user.firstName }}
        {% endif %}! 🏸
    </h1>

     <p class="intro-text">
        {{ 'Depuis sa création, le club ne cesse de grandir grâce à l\'engagement de ses bénévoles et à la passion de ses'|trans }}
        <strong>{{ 'deux entraîneurs salariés'|trans }}</strong>. 
        {{ 'Une aventure collective tournée vers l\'excellence et le plaisir de jouer !'|trans }}
    </p>

{% endblock %}


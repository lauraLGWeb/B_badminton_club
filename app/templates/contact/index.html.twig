{% extends 'base.html.twig' %}
{% block title %}{{ 'Contacte-nous'|trans }}{% endblock %}

{% block body %}

<h1>{{ 'Contacte-nous !'|trans }}</h1>

<h2>{{ 'Regarde notre FAQ, peut-être que la réponse à ta question y est déjà'|trans }}</h2>

<details>
    <summary>{{ 'Faut-il apporter son propre matériel ou le club en fournit ?'|trans }}</summary>
    <p>{{ 'Pour les essais, nous pouvons prêter une raquette !'|trans }}</p>
    <p>{{ 'Sinon nous te conseillons de venir avec les indispensables de la pratique du badminton que tu retrouves'|trans }} <a href="{{ path('app_try') }}">{{ 'dans la section Essai'|trans }}</a></p>
</details>

<details>
    <summary>{{ 'Comment s\'inscrire au club ?'|trans }}</summary>
    <p>{{ 'L\'inscription au club se fait directement sur le site de'|trans }}
    <a href="https://www.ffbad.org/pratiquer-se-licencier-licence" target="_blank">{{ 'La Fédération Française De Badminton : FFBAD'|trans }}</a></p>
</details>

<details>
    <summary>{{ 'Le club accepte-t-il les débutants ?'|trans }}</summary>
    <p>{{ 'Tout à fait, tout le monde est le bienvenu au club !'|trans }}</p>
</details>

<details>
    <summary>{{ 'Peut-on faire un cours d\'essai avant de s\'inscrire ?'|trans }}</summary>
    <p>{{ 'Oui et nous te le recommandons avant de t\'engager ! Jette un coup d\'œil à notre section'|trans }} <a href="{{ path('app_try') }}">{{ 'essais'|trans }}</a></p>
</details>

<details>
    <summary>{{ 'Y a-t-il une limite d\'âge pour rejoindre le club ?'|trans }}</summary>
    <p>{{ 'Tu peux t\'inscrire peu importe ton âge !'|trans }}</p>
    <p>{{ 'Si tu veux faire venir ton très jeune enfant (3-5 ans), nous lui proposons un essai qui sera encadré par l\'un de nos entraîneurs afin de définir s\'il n\'est pas trop jeune pour jouer.'|trans }}</p>
</details>

<h2>{{ 'Sinon, envoie-nous un mail directement via ce formulaire'|trans }}</h2>

<div class="emailSent">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            {{ message|trans }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">
            {{ message|trans }}
        </div>
    {% endfor %}
</div>

{{ form_errors(contactForm) }}

{{ form_start(contactForm) }}
    
    {{ form_row(contactForm.firstName, {
        'label': 'Prénom'|trans
    }) }}
    
    {{ form_row(contactForm.lastName, {
        'label': 'Nom'|trans
    }) }}
    
    {{ form_row(contactForm.email, {
        'label': 'Email'|trans
    }) }}
    
    {{ form_row(contactForm.message, {
        'label': 'Ton message'|trans
    }) }}

    {{ form_row(contactForm.send) }}
    
    {{ form_row(contactForm.reset, {
        'label': 'Effacer'|trans
    }) }}
  
{{ form_end(contactForm) }}

{% endblock %}
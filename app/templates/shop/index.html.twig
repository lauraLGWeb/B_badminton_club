{% extends 'base.html.twig' %}

{% block meta %}
    <meta 
        name="description" 
        content="Boutique officielle du Blois Badminton Club : commandez vos T-shirts, accessoires et équipements en ligne. Paiement sécurisé par carte bancaire. Retrait au club." />
{% endblock %}

{% block title %} {{ 'Boutique'|trans }} {% endblock %}

{% block body %}
<section class="youth-block">
    <h1>{{ 'La boutique du Blois Badminton Club'|trans }}</h1>

    <div class="youth-block">
        <p>{{ 'Notre boutique est hébergée sur HelloAsso, une plateforme sécurisée et sans frais pour le club.'|trans }}</p>
        <p>{{ 'Tu y retrouveras nos T-shirts, et accessoires. Une fois ta commande passée, tu récupères tes articles auprès d\'un membre du bureau.'|trans }}</p>
         <a class="newLicence " target="_blank" href="https://www.helloasso.com/associations/blois-badminton-club/boutiques/maillot-du-bbc">
        {{ 'Accéder à la boutique'|trans }}
    </a>
    </div>
</section>

{% endblock %}

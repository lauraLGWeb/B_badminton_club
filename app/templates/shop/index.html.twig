{% extends 'base.html.twig' %}

{% block title %} Boutique {% endblock %}

{% block stylesheets %}
        <script defer src="{{asset('styles/JS/main.js') }}"></script>
        <link rel="stylesheet" href="{{ asset('styles/CSS/app.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/CSS/mentions.css') }}">
        <link rel="shortcut icon" href="{{ asset('pictures/logo.jpeg') }}" type="image/x-icon">
        <link rel="stylesheet" href="{{ asset('styles/CSS/shop.css') }}">
        
    {% endblock %}

{% block body %}


<section class="shop">

    <h1> Bienvenue dans la boutique du Blois Badminton Club !</h1>

    <div class="presentationAndCart">
        <h2>Ici, tu peux commander directement tes articles et payer en ligne par carte bancaire en toute sécurité.
        Une fois ton paiement effectué, tu pourras récupérer tes produits auprès d’un membre du bureau du club.
        Parcours notre sélection de T-shirts, accessoires et matériel, et équipe-toi facilement tout en soutenant le club ! </h2>
    </div>

    <div class="filter">
        <p class="pFilter"> filtres </p>
        <a href="{{ path('app_cart') }}"> <img src="{{asset("pictures/cart.png")}}" alt="logo panier">
        </a>
        
       
    </div>
    


    <section class="products">
    {% for product in products %}
            <div class="product">
                <div class="imgShop">
                    <img src="{{product.picture}}" alt="T-shirt">
                </div>
                <div class ="detailsShop">
                    <h2 class="productTitle">{{product.title}}</h2>
                    <p>{{product.description}}</p>
                    <p class="price">{{ product.price|number_format(2, ',', ' ') }} €</p>
                    {% if product.hasSize %}
                        <select class="size">
                            <option value="">Choisir une taille</option>
                            <option value="XS">XS</option>
                            <option value="S">S</option>
                            <option value="M">M</option>
                            <option value="L">L</option>
                            <option value="XL">XL</option>
                            <option value="XXL">XXL</option>  
                        </select>

                        <select class="gender">
                            <option value="">Choisir un genre</option>
                            <option value="man">Homme</option>
                            <option value="woman">Femme</option>
                        </select>
                    {% endif %}
                    <button>Ajouter au panier</button>
                </div>
            </div>
    {% endfor %} 
    </section>

  
</section>

{% endblock %}

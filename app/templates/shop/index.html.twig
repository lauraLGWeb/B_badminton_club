{% extends 'base.html.twig' %}

{% block meta %}
    <meta 
        name="description" 
        content="Boutique officielle du Blois Badminton Club : commandez vos T-shirts, accessoires et équipements en ligne. Paiement sécurisé par carte bancaire. Retrait au club." />
{% endblock %}

{% block title %} {{ 'Boutique'|trans }} {% endblock %}

{% block stylesheets %}
        <script defer src="{{asset('styles/JS/main.js') }}"></script>
        <script defer src="{{asset('styles/JS/addItem.js') }}"></script>
        <script defer src="{{asset('styles/JS/cart.js') }}"></script>
        <link rel="stylesheet" href="{{ asset('styles/CSS/app.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/CSS/mentions.css') }}">
        <link rel="shortcut icon" href="{{ asset('pictures/logo.jpeg') }}" type="image/x-icon">
        <link rel="stylesheet" href="{{ asset('styles/CSS/shop.css') }}">
{% endblock %}

{% block body %}

<section class="shop">
    <h1>{{ 'Bienvenue dans la boutique du Blois Badminton Club !'|trans }}</h1>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-{{ type }}">
                {{ message|trans }}
            </div>
        {% endfor %}
    {% endfor %}

    <div class="presentationAndCart">
        <h2>{{ 'Ici, tu peux commander directement tes articles et payer en ligne par carte bancaire en toute sécurité.
        Une fois ton paiement effectué, tu pourras récupérer tes produits auprès d\'un membre du bureau du club.
        Parcours notre sélection de T-shirts, accessoires et matériel, et équipe-toi facilement tout en soutenant le club !'|trans }}</h2>
    </div>
    

    <div class="filter">
        <p class="pFilter">{{ 'filtres'|trans }}</p>
        <div>
            <a href="{{ path('app_cart') }}"> 
                <img src="{{asset("pictures/cart.png")}}" alt="{{ 'product.title'|trans }}">
            </a>
            {% if cart %}
                {% set total = 0 %}
                {% for item in cart.CartItem %}
                    {% set total = total + (item.quantity) %}
                {% endfor %}
                <p class="cartItemNbr">{{total}}</p>
            {% endif %}
        </div>
    </div>

    <section class="products">
    {% for product in products %}
        <div class="product">
            <div class="imgShop">
                <img src="{{asset(product.picture)}}" alt="{{product.title}}">
            </div>
            <div class="detailsShop">
                <h2 class="productTitle">{{product.title}}</h2>
                <p>{{product.description}}</p>
                <p class="price">{{ product.price|number_format(2, ',', ' ') }} €</p>

                <form class="add-to-cart-form" action="{{ path('app_addItem', { id: product.id }) }}" method="POST">
                    {% if product.hasSize %}
                    <div class="selects">
                        <label for="size">{{ 'Choisit la taille :'|trans }}</label>
                        <select name="size" id="size" class="select-shop size">  
                            <option value="">{{ 'Choisir une taille'|trans }}</option>
                            <option value="XS">XS</option>
                            <option value="S">S</option>
                            <option value="M">M</option>
                            <option value="L">L</option>
                            <option value="XL">XL</option>
                            <option value="XXL">XXL</option>  
                        </select>

                        <label for="gender">{{ 'Choisit le genre'|trans }}</label>
                        <select name="gender" id="gender" class="select-shop gender">  
                            <option value="">{{ 'Choisir un genre'|trans }}</option>
                            <option value="man">{{ 'Homme'|trans }}</option>
                            <option value="woman">{{ 'Femme'|trans }}</option>
                        </select>
                    </div>
                    {% endif %}

                    <input type="hidden" name="_token" value="{{ csrf_token('hasSize_form' ~ product.id) }}">
                    
                    <button type="submit" class="btn">
                        {{ 'Ajouter au panier'|trans }}
                    </button>
                </form>
            </div>
        </div>
    {% endfor %} 
    </section>
</section>

{% endblock %}

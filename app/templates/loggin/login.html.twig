{% extends 'base.html.twig' %}

{% block meta %}
    <meta 
        name="description" 
        content="Connectez-vous à votre espace membre du Blois Badminton Club. Accédez à la boutique, consultez vos commandes et gérez votre compte en toute sécurité." />

        <script defer src="{{ asset('styles/JS/passwordLogin.js') }}"></script>
{% endblock %}

{% block title %}{{ 'Connexion'|trans }}{% endblock %}

{% block body %}
    <div class="login-container">
        <form method="post" class="login-form">
            {% if error %}
                <div class="alert-message">
                    {{ 'Mot de passe ou email incorrect.'|trans }}
                </div>
            {% endif %}

            {% if app.user %}
                <div class="user-info">
                    {{ 'Connecté en tant que'|trans }} {{ app.user.userIdentifier }} : 
                    <a href="{{ logout_path() }}" class="logout-link">{{ 'Se déconnecter'|trans }}</a>
                </div>
            {% endif %}
            
            <h1 class="login-title">{{ 'Connecte-toi vite !'|trans }}</h1>
            <p class="register-prompt">
                {{ 'Tu n\'as pas encore de compte ?'|trans }}
                <a href="{{ path("app_register") }}" class="register-link">{{ 'M\'inscrire'|trans }}</a>
            </p>
                        
            <div class="input-group">
                <label for="username" class="input-label">{{ 'Email'|trans }}</label>
                <input 
                    type="email" 
                    value="{{ last_username }}" 
                    name="_username" 
                    id="username" 
                    class="input-field" 
                    autocomplete="email" 
                    required 
                    autofocus
                >
            </div>

            <div class="input-group">
                <label for="password" class="input-label">{{ 'Mot de passe'|trans }}</label>
                <div class="inside-group">
                <input 
                    type="password"
                    name="_password" 
                    id="password" 
                    class="input-field" 
                    autocomplete="current-password" 
                    required
                >
               <img id="viewPicto" 
                src="{{ asset('pictures/view.png') }}" 
                data-view="{{ asset('pictures/view.png') }}"
                data-hide="{{ asset('pictures/hide.png') }}">
                </div>
            </div>

            <input 
                type="hidden" 
                name="_csrf_token" 
                data-controller="csrf-protection" 
                value="{{ csrf_token('authenticate') }}"
            >
            
            <button class="submit-button" type="submit">
                {{ 'Me connecter'|trans }}
            </button>
            <button>  <a href="{{ path("app_forgot_password_request") }}" class="register-link">{{ 'Réinitialiser mon mot de passe'|trans }}</a></button>
        </form>
    </div>
{% endblock %}
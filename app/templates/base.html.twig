<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Blois Badminton Club{% endblock %}</title>
        {% block stylesheets %}  
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
        {% endblock %}
        
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
    
    <header>
        {% block logoContainer %}
         <section class="logoAndBtnContainer d-flex justify-content-between align-items-center px-3 py-2 bg-light">
            <a href="{{ path('app_home') }}">
                 <img src="{{ asset('pictures/logo.jpeg') }}" width="150px" alt="logo">
            </a>
        
            <div>
                <button class="btn btn-outline-secondary">EN </button>
                <button class="btn btn-outline-secondary">Mode</button>
            </div>
    </section>
        {% endblock %}

        {# on everypage #}
        {% block menu %}
        <section class="navBarContainer">
            <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
                <div class="container-fluid">
                    <div class="dropdown me-2">
                        <button class="btn btn-warning dropdown-toggle" type="button" id="dropdownClub" data-bs-toggle="dropdown" aria-expanded="false">
                            Le club
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownClub">
                            <li><a class="dropdown-item" href="{{ path('app_members') }}">Membres du CA</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_coaches') }}">Nos entraîneurs</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_rules') }}">Règlement</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_internships') }}">Stages</a></li>
                        </ul>
                    </div>
                    
                    <div class="dropdown me-2">
                        <button class="btn btn-warning dropdown-toggle" type="button" id="dropdownEcole" data-bs-toggle="dropdown" aria-expanded="false">
                            École du bad
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownEcole">
                            <li><a class="dropdown-item" href="{{ path('app_home') }}">Section 1</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_home') }}">Section 2</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_home') }}">Section 3</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_home') }}">Section 4</a></li>
                        </ul>
                    </div>
                    
                    <a class="btn btn-link text-white" href="{{ path('app_prices') }}">Tarifs</a> 
                    <a class="btn btn-link text-white" href="{{ path('app_actuality') }}">Actualité</a> 
                    <a class="btn btn-link text-white" href="{{ path('app_partners') }}">Ils nous soutiennent</a>
                    
                    {% if app.user %}
                        <a class="btn btn-outline-light me-2" href="{{ path('app_shop') }}">Boutique</a>
                        <a class="btn btn-link text-white" href="{{ path('app_logout') }}">Me déconnecter</a> 
                    {% else %} 
                        <a class="btn btn-link text-white" href="{{ path('app_login') }}">Mon compte</a>
                    {% endif %}
                    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_COACH') %}
                        <a class="btn btn-danger" href="{{ path('app_admin_dashboard') }}">Administration</a>
                    {% endif %}
                </div>
            </nav>
        </section>
        {% endblock %}

        {# on everypage #}
        {% block buttonsContainer %}
        <section class="secondMenuContainer d-flex justify-content-center gap-3 py-3 bg-light">
            <a class="btn btn-primary" href="{{ path('app_schedules') }}">Voir les créneaux</a>

                    {% if app.user %} 
                        <a class="btn btn-primary" href="{{ path('app_account') }}">Mon compte </a> 
                    {% else %} 
                        <a class="btn btn-primary" href="{{ path('app_register') }}">M'inscrire</a>
                    {% endif %}


            <a class="btn btn-primary" href="{{ path('app_try') }}">Faire un essai</a>
        </section>
        {% endblock %}
    </header>

    
    {% block body %}
    {% endblock %}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    </body>
</html>
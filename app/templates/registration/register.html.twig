{% extends 'base.html.twig' %}

{% block title %}Création compte{% endblock %}


{% block body %}
    <h1 class="PageTitle">Créer mon compte</h1>

    {# Affiche les erreurs globales ET celles des champs #}
    {% for error in registrationForm.vars.errors %}
        <div class="alert alert-danger">{{ error.message }}</div>
    {% endfor %}

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm, {'attr': {'novalidate' : 'novalidate'}}) }}
        
       
        {{ form_row(registrationForm.firstName, {
            label: 'Prénom'
        }) }}
        {{ form_row(registrationForm.lastName, {
            label: 'Nom'
        }) }}
        {{ form_row(registrationForm.lienceNbr, {
            label: 'Numéro de Licence'
        }) }}
        {{ form_row(registrationForm.email) }}
        {{ form_row(registrationForm.plainPassword, {
            label: 'Mot de passe : Le mot de passe doit contenir au moins 8 caractères, une majuscule et un chiffre'
        }) }}
        {{ form_row(registrationForm.agreeTerms, {
            label: 'J\'accepte les <a href="' ~ path('app_legalMentions') ~ '">conditions générales</a>',
            label_html: true
        }) }}
        <button type="submit" class="submit-button">Créer mon compte</button>
    {{ form_end(registrationForm) }}


{% endblock %}


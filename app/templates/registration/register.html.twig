{% extends 'base.html.twig' %}

{% block meta %}
    <meta 
        name="description" 
        content="Créez votre compte membre au Blois Badminton Club. Accédez à la boutique en ligne, gérez vos commandes et profitez de tous les services réservés aux licenciés du club." />

         <script defer src="{{ asset('styles/JS/passwordRegistration.js') }}"></script>
{% endblock %}

{% block title %}{{ 'Création compte'|trans }}{% endblock %}

{% block body %}
    <h1 class="PageTitle">{{ 'Créer mon compte'|trans }}</h1>

    {# Affiche les erreurs globales ET celles des champs #}
    {% for error in registrationForm.vars.errors %}
        <div class="alert alert-danger">{{ error.message }}</div>
    {% endfor %}

    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm, {'attr': {'novalidate': 'novalidate'}}) }}
    
    <p class="form-notice"><span class="required-mark">*</span> Champs obligatoires</p>
        {{ form_row(registrationForm.firstName, {
            'label': 'Prénom'|trans,
            'attr': {
            'placeholder': 'Lucie',
            'autocomplete': 'given-name'
}
        }) }}

        {{ form_row(registrationForm.lastName, {
            'label': 'Nom'|trans,
            'attr': {
            'placeholder': 'Dupont',
            'autocomplete': 'family-name'
            }
        }) }}

         {{ form_row(registrationForm.phoneNbr, {
            'label': 'Numéro de téléphone'|trans,
            'attr': {
            'placeholder': '06XXXXXXXX', 
            'autocomplete': 'tel'}
        }) }}

        {{ form_row(registrationForm.lienceNbr, {
            'label': 'Numéro de Licence (obligatoire pour les membres du club)'|trans,
            'attr': {
            'placeholder': '1234567', 
    }
            
        }) }}
        
        {{ form_row(registrationForm.email,{
            'attr': {
            'placeholder': 'marie.dupont@exemple.fr', 
            'autocomplete': 'email'
            }
        })
        }}
    
         <div class="input-group">
            {{ form_label(registrationForm.plainPassword, 'Mot de passe : Le mot de passe doit contenir au moins 16 caractères, une majuscule, un caractère spécial et un chiffre'|trans) }}
            {{ form_errors(registrationForm.plainPassword) }}
            <div class="inside-group">
                {{ form_widget(registrationForm.plainPassword, {
                    'attr': {
                        'autocomplete': 'new-password',
                    }
                }) }}
                <img id="viewPictoRegistration" 
                    src="{{ asset('pictures/view.png') }}" 
                    data-viewPathRegistration="{{ asset('pictures/view.png') }}"
                    data-hidePathRegistration="{{ asset('pictures/hide.png') }}"
                    width="50px"
                    >
                    
            </div>
        </div>


        {{ form_row(registrationForm.agreeTerms, {
            'label': ('J\'accepte les <a href="' ~ path('app_legalMentions') ~ '">conditions générales</a>')|trans,
            'label_html': true,
            'row_attr': {'class': 'boxCase'}
        }) }}

            {{ form_row(registrationForm.agreeCollect, {
            'label': ('J\'accepte la collecte de mes données')|trans,
            'label_html': true,
            'row_attr': {'class': 'boxCase'}
        }) }}
        
        <button type="submit" class="submit-button">{{ 'Créer mon compte'|trans }}</button>
        
    {{ form_end(registrationForm) }}

{% endblock %}
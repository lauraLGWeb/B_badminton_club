{% extends 'base.html.twig' %}
{% block title %}Stages{% endblock %}


{% block body %}
    <section class="IntershipBookingPresentation">
    <div class="titleAndBtnComeBack">
        <h1> M'inscrire pour le stage du {{ internship.dateTime|date('d/m/Y') }} à {{ internship.dateTime|date('H:i') }}</h1>

        <a href="{{ path('app_internships')}}" role="button" class="btn-back">Retour aux stages</a>
    </div>

    <div class="bookingState">
    <p>Actuellement 
        {% if internship.AlreadyBooked > 0 %}
            <span class="booked"> il y à {{ internship.AlreadyBooked }} inscription(s) faite()</span>
        {% else %}
            <span class="empty">il n'y a aucun inscrit</span>
        {% endif %}
        <span> sur {{ internship.MaxPlayersNbr }} places </span>
        </p>
    </div>
</section>

<h2>{{ internship.internshipTitle }} :</h2>

    {{ form_errors(form) }}

    {{ form_start(form, {'attr': {'novalidate' : 'novalidate'}}) }}
       
        {{ form_row(form.LastName, {
            label: 'Nom'
        }) }}
        {{ form_row(form.FirstName, {
            label: 'Prénom'
        }) }}
        {{ form_row(form.email, {
            label: 'Email '
        }) }}
        {{ form_row(form.phoneNumber, {
            label: 'Numéro de portable'
        }) }} 
        {{ form_row(form.SimpleRank, {
            label: 'Classement en Simple'
        }) }} 
        {{ form_row(form.DoubleRank, {
            label: 'Classement en Double'
        }) }} 
        {{ form_row(form.MixteRank, {
            label: 'Classement en Mixte'
        }) }} 

        <button type="submit" class="submit-button"> Envoyer mon inscription</button>

    {{ form_end(form) }}
      

{% endblock %}


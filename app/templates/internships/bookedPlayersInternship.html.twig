{% extends 'base.html.twig' %}
{% block title %}{{ 'internship.page_title'|trans }}{% endblock %}

{% block body %}
<section class="members-list">
    <section class="IntershipBookingPresentation">
        <div class="titleAndBtnComeBack">
            <h1>
                {{ 'internship.registrations_for'|trans }}
                {{ internship.dateTime|date('d/m/Y') }}
                {{ 'internship.at'|trans }}
                {{ internship.dateTime|date('H:i') }}
            </h1>

            <a href="{{ path('app_internships')}}" role="button" class="btn-back">
                {{ 'internship.back_to_list'|trans }}
            </a>
        </div>
    </section>

    {# Flash messages #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-{{ type }}">
                {{ message|trans }}
            </div>
        {% endfor %}
    {% endfor %}

    {# Internship status #}
    <section class="internshipStatus">

        {% if internship.AlreadyBooked is same as internship.maxPlayersNbr %}
            <p class="full">
                {{ 'internship.full'|trans }}
            </p>
        {% endif %}

        {% if internship.AlreadyBooked > 0 %}
            <span class="booked">
                {{ internship.AlreadyBooked }}
            </span>
        {% else %}
            <p class="empty">
                {{ 'internship.no_registration_yet'|trans }}
            </p>
            <span class="booked">0</span>
        {% endif %}

        <span class="booked">
            / {{ internship.MaxPlayersNbr }}
        </span>
    </section>

    {# Players table #}
    {% if internship.AlreadyBooked > 0 %}
        <table>
            <thead>
                <tr>
                    <th>{{ 'table.last_name'|trans }}</th>
                    <th>{{ 'table.first_name'|trans }}</th>
                    <th>{{ 'table.simple'|trans }}</th>
                    <th>{{ 'table.double'|trans }}</th>
                    <th>{{ 'table.mixte'|trans }}</th>
                    <th>{{ 'table.email'|trans }}</th>
                    <th>{{ 'table.phone'|trans }}</th>
                    <th>{{ 'table.delete'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for player in players %}
                    <tr>
                        <td>{{ player.LastName }}</td>
                        <td>{{ player.FirstName }}</td>
                        <td>{{ player.SimpleRank }}</td>
                        <td>{{ player.DoubleRank }}</td>
                        <td>{{ player.MixteRank }}</td>
                        <td><a href="mailto:{{ player.email }}">{{ player.email }}</a></td>
                        <td><a href="tel:{{ player.phoneNumber }}">{{ player.phoneNumber }}</a></td>
                        <td> 
                            <form class="noStyle"
                                  action="{{ path('app_deletePlayersInternship', { id: player.id }) }}" 
                                  method="post"
                                  onsubmit="return confirm('{{ 'internship.confirm_delete'|trans }}')">

                                <input type="hidden" 
                                       name="_token" 
                                       value="{{ csrf_token('delete_player_' ~ player.id) }}">

                                <button type="submit" class="deleteItem">
                                    {{ 'internship.unregister'|trans }}
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>  
    {% endif %}     

</section>
{% endblock %}

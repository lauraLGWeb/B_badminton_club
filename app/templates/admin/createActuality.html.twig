{% extends 'base.html.twig' %}

{% block title %}{{ 'Création d\'une nouvelle actualité'|trans }}{% endblock %}

{% block body %}

    <h1>{{ 'Création d\'une nouvelle actualité'|trans }}</h1>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-{{ type }}">
                {{ message|trans }}
            </div>
        {% endfor %}
    {% endfor %}

    {{ form_errors(form) }}

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        
        {{ form_row(form.title, {
            'label': 'Titre'|trans
        }) }}
        
        {{ form_row(form.description, {
            'label': 'Description'|trans
        }) }}
        
        {{ form_row(form.picture, {
            'label': 'Lien de l\'image'|trans
        }) }}
        
        {{ form_row(form.eventOn, {
            'label': 'Date de l\'événement'|trans
        }) }}

        <button type="submit" class="submit-button">
            {{ 'Publier l\'événement'|trans }}
        </button>

    {{ form_end(form) }}

{% endblock %}
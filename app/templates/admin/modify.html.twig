{% extends "base.html.twig" %}

{% block body %} 
 
<h1> Modifier un membre </h1>


{{ form_start(formulaire) }}
    {{ form_row(formulaire.firstName, {'attr': {'novalidate' : 'novalidate'}}, {
            label: 'Prénom'
        }) }}

        {{ form_row(formulaire.lastName, {
            label: 'Nom'
        }) }}


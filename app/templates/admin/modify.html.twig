{% extends "base.html.twig" %}

{% block body %}

<h1>{{ 'Modifier un membre'|trans }}</h1>

{{ form_start(formulaire, {'attr': {'novalidate': 'novalidate'}}) }}

    {{ form_row(formulaire.firstName, {
        'label': 'Prénom'|trans
    }) }}

    {{ form_row(formulaire.lastName, {
        'label': 'Nom'|trans
    }) }}

    {{ form_row(formulaire.lienceNbr, {
        'label': 'Numéro de Licence'|trans
    }) }}

    {{ form_row(formulaire.email, {
        'label': 'Email'|trans
    }) }}

    {{ form_row(formulaire.roles, {
        'label': 'Statut'|trans
    }) }}

    <button class="submit-btn" type="submit">
        {{ 'Mettre à jour le Contact'|trans }}
    </button>

{{ form_end(formulaire) }}

{% endblock %}
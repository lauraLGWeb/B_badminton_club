{% extends 'base.html.twig' %}

{% block title %}{{ 'Liste des produits'|trans }}{% endblock %}

{% block body %}

<div class="members-list">
    <h1>{{ 'Voici tous les articles'|trans }}</h1>
    
{% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-{{ type }}">
                {{ message|trans }}
            </div>
        {% endfor %}
    {% endfor %}

    <a href="{{ path('app_AddItemsList') }}" class="btn-item">
        + {{ 'Ajouter un produit'|trans }} →
    </a>
    
    <section class="products">
        {% for product in products %}
            <div class="product">
                <h2 class="productTitle">{{ product.title }}</h2>
                <img 
                    class="pic-items" 
                    src="{{ asset(product.picture) }}" 
                    alt="{{ product.title }}"
                    onerror="this.src='{{ asset('https://placehold.co/400x250/FF6B35/white?text=Image+Indisponible') }}'">
                <p>{{ product.description }}</p>
                <p class="price">{{ product.price|number_format(2, ',', ' ') }} €</p>
                <div class="btn-modif-item">
                   
                    <form class="actuForm" 
                              action="{{ path('app_deleteProduct', {'id': product.id}) }}" 
                              method="post" >
                            <input type="hidden" 
                                   name="_token" 
                                   value="{{ csrf_token('app_modifyItem' ~ product.id) }}">
                            <button type="submit" class="btn-item">
                                {{ 'Modifier'|trans }} →
                        </button>
                    </form> 
                    <form class="actuForm" 
                              action="{{ path('app_deleteProduct', {'id': product.id}) }}" 
                              method="post" 
                              onsubmit="return confirm('{{ 'Supprimer cet article ?'|trans }}')">
                            <input type="hidden" 
                                   name="_token" 
                                   value="{{ csrf_token('delete_Product_' ~ product.id) }}">
                            <button type="submit" class="btn-item">
                                {{ 'Supprimer'|trans }} →
                        </button>
                    </form>
                </div>
            </div>
        {% endfor %}
    </section>
</div>

{% endblock %}
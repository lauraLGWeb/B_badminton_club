{% extends 'base.html.twig' %}

{% block title %}{{ 'Création d\'un nouveau produit'|trans }}{% endblock %}

{% block body %}

<div class="container">
     {% if app.current_route == 'app_AddItemsList' %}
            <h1>{{ 'Création d\'un nouveau produit'|trans }}</h1>
        {% elseif app.current_route == 'app_modifyItem' %}
            <h1>{{ 'Modification d\'un produit'|trans }}</h1>
        {% endif %}

        
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-{{ type }}">
                {{ message|trans }}
            </div>
        {% endfor %}
    {% endfor %}

    {{ form_errors(form) }}

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

        {{ form_row(form.title, {
            'label': 'Nom du produit'|trans
        }) }}
        
        {{ form_row(form.description, {
            'label': 'Description'|trans
        }) }}
        
        {{ form_row(form.picture, {
            'label': 'Lien de l\'image'|trans
        }) }}
        
        {{ form_row(form.price, {
            'label': 'Prix (€)'|trans,
            'attr': {
                'step': '0.01',
                'min': '0'
            }
        }) }}
        
        {{ form_row(form.hasSize, {
            'label': 'Ce produit a-t-il des tailles ?'|trans
        }) }}

        <button type="submit" class="submit-button">
            {% if app.current_route == 'app_AddItemsList' %}
             {{ 'Publier le produit'|trans }}
        {% elseif app.current_route == 'app_modifyItem' %}
             {{ 'Mettre à jour le produit'|trans }}
        {% endif %}
            
        </button>

    {{ form_end(form) }}
    
</div>

{% endblock %}
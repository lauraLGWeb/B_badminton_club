{% extends 'base.html.twig' %}

{% block title %} Création d'un nouveau produit {% endblock %}


{% block body %}

    {% for type, messages in app.flashes %}
    {# going through each of the 3 messages #}
        {% for message in messages %}
            <div class="flash-{{ type }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

<div class="container">

    <h1>Création d'un nouveau produit</h1>
        
        {{ form_errors(form) }}

        {{ form_start(form, {'attr': {'novalidate' : 'novalidate'}}) }}
            
        
            {{ form_row(form.title, {
                label: 'Nom du produit'
            }) }}
            {{ form_row(form.description, {
                label: 'Description'
            }) }}
            {{ form_row(form.picture, {
                label: 'Lien de l\'image '
            }) }}
            {{ form_row(form.price, {
                label: 'Prix (€)',
                attr: {
                    'step': '0.01',
                    'min': '0'
                }
            }) }}
            {{ form_row(form.hasSize, {
                label: 'Ce produit a-t-il des tailles ?'
            }) }} 
                

            <button type="submit" class="submit-button">publier le nouvel article </button>

        {{ form_end(form) }}
</div>

{% endblock %}


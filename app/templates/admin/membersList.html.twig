{% extends 'base.html.twig' %}

{% block title %}{{ 'Liste des membres'|trans }}{% endblock %}

{% block body %}

<div class="members-list">
    <h1>{{ 'Voici tous les membres'|trans }}</h1>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-{{ type }}">
                {{ message|trans }}
            </div>
        {% endfor %}
    {% endfor %}

    <h2>{{ 'Licences à Valider'|trans }}</h2>

    <table>
        <thead>
            <th>{{ 'Nom'|trans }}</th>
            <th>{{ 'Prénom'|trans }}</th>
            <th>{{ 'Email'|trans }}</th>
            <th>{{ 'Licence'|trans }}</th>
            <th>{{ 'Modifier'|trans }}</th>
            <th>{{ 'Supprimer'|trans }}</th>
            <th>{{ 'Valider'|trans }}</th>
        </thead>
        <tbody>
            {% for user in user %}
                {% if not user.isVerified %}
                    <tr>
                        <td>{{ user.firstName }}</td>
                        <td>{{ user.lastName }}</td>
                        <td>{{ user.email }}</td>
                        <td>{{ user.lienceNbr }}</td>
                        <td>
                            <a href="{{ path('app_modify', {'id': user.id}) }}">
                                {{ 'Modifier'|trans }}
                            </a>
                        </td>
                        <td>
                            <form class="noStyle" 
                                  action="{{ path('app_delete', {'id': user.id}) }}" 
                                  method="post" 
                                    onsubmit="return confirm(this.dataset.confirmMessage);"
                                    data-confirm-message="{{ 'Supprimer ce membre ?'|trans }}">
                                <input type="hidden" 
                                       name="_token" 
                                       value="{{ csrf_token('delete_member_' ~ user.id) }}">
                                <button type="submit" class="deleteItem">
                                    {{ 'Supprimer'|trans }}
                                </button>
                            </form>
                        </td>
                        <td>
                            <form class="noStyle" 
                                  action="{{ path('app_validateLicence', {'id': user.id}) }}" 
                                  method="post" 
                                    onsubmit="return confirm(this.dataset.confirmMessage);"
                                    data-confirm-message="{{ 'Valider l\'Inscription ?'|trans }}">
                                <input type="hidden" 
                                       name="_token" 
                                       value="{{ csrf_token('validate_licence_' ~ user.id) }}">
                                <button type="submit" class="deleteItem">
                                    {{ 'Valider'|trans }}
                                </button>
                            </form>
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
        </tbody>
    </table>

    <h2>{{ 'Licences vérifiées'|trans }}</h2>
    
    <table>
        <thead>
            <th>{{ 'Nom'|trans }}</th>
            <th>{{ 'Prénom'|trans }}</th>
            <th>{{ 'Email'|trans }}</th>
            <th>{{ 'Licence'|trans }}</th>
            <th>{{ 'Modifier'|trans }}</th>
            <th>{{ 'Supprimer'|trans }}</th>
            <th>{{ 'Valider'|trans }}</th>
        </thead>
        <tbody>
            {% for user in user %}
                {% if user.isVerified %}
                    <tr>
                        <td>{{ user.lastName }}</td>
                        <td>{{ user.firstName }}</td>
                        <td>{{ user.email }}</td>
                        <td>{{ user.lienceNbr }}</td>
                        <td>
                            <a href="{{ path('app_modify', {'id': user.id}) }}">
                                {{ 'Modifier'|trans }}
                            </a>
                        </td>
                        <td>
                            <form class="noStyle" 
                                  action="{{ path('app_delete', {'id': user.id}) }}" 
                                  method="post" 
                                    onsubmit="return confirm(this.dataset.confirmMessage);"
                                    data-confirm-message="{{ 'Supprimer ce membre ?'|trans }}">
                                <input type="hidden" 
                                       name="_token" 
                                       value="{{ csrf_token('delete_member_' ~ user.id) }}">
                                <button type="submit" class="deleteItem">
                                    {{ 'Supprimer'|trans }}
                                </button>
                            </form>
                        </td>
                        <td>
                            <p>{{ 'Déjà validé'|trans }}</p>
                        </td>
                    </tr>
                {% endif %}
            {% endfor %}
        </tbody>
    </table>
</div>

{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}{{ 'Liste des commandes'|trans }}{% endblock %}

{% block body %}

<div>
    <h1>{{ 'Voici toutes les commandes passées'|trans }}</h1>

    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="flash-{{ type }}">
                {{ message|trans }}
            </div>
        {% endfor %}
    {% endfor %}

    <h2>{{ 'À donner'|trans }} :</h2>

    {% set pendingOrders = 0 %}

    {% for order in orders %}
        {% if not order.IsGiven %}
            {% set pendingOrders = pendingOrders + 1 %}
            <section class="ordersContainer">
                <div class="ordersDiv">
                    <div class="ordersTop">
                        <div>
                            <h3>{{ 'Commande numéro'|trans }} : {{ order.id }}</h3>
                            <p>{{ 'Client'|trans }} : {{ order.user.firstName }} {{ order.user.lastName }}</p>
                            <p>{{ 'Date'|trans }} : {{ order.purchaseDate|date('d/m/Y H:i') }}</p>
                        </div>
                        
                        <form method="post" 
                              action="{{ path('app_orderGiven', {'id': order.id}) }}" 
                              onsubmit="return confirm('{{ 'Valider la remise du/des produit(s) ?'|trans }}')">
                            <label for="orderGiven">{{ 'Commande donnée'|trans }} :</label>
                            <input type="hidden" 
                                   name="_token" 
                                   value="{{ csrf_token('mark_order_' ~ order.id) }}">
                            <button type="submit" class="btn-validate">{{ 'Oui'|trans }}</button>
                        </form>
                    </div>
                    
                    <h4>{{ 'Articles'|trans }} :</h4>
                    <div>
                        {% for item in order.cartItem %}
                            <p>{{ item.product.title }} {{ item.size }} {{ item.gender }} (x{{ item.quantity }})</p>
                        {% endfor %}
                    </div>
                </div>
            </section>
        {% endif %}
    {% endfor %}

    {% if pendingOrders == 0 %}
        <div class="no-actuality">
            <p>{{ 'Aucune commande non remise pour le moment.'|trans }}</p>
        </div>
    {% endif %}

    <h2>{{ 'Déjà donnée'|trans }} :</h2>

    {% for order in orders %}
        {% if order.IsGiven %}
            <section class="ordersContainer">
                <div class="ordersDiv">
                    <h3>{{ 'Commande numéro'|trans }} : {{ order.id }}</h3>
                    <p>{{ 'Client'|trans }} : {{ order.user.firstName }} {{ order.user.lastName }}</p>
                    <p>{{ 'Date'|trans }} : {{ order.purchaseDate|date('d/m/Y H:i') }}</p>
                    
                    <h4>{{ 'Articles'|trans }} :</h4>
                    <div>
                        {% for item in order.cartItem %}
                            <p>{{ item.product.title }} {{ item.size }} {{ item.gender }} (x{{ item.quantity }})</p>
                        {% endfor %}
                    </div>
                </div>
            </section>
        {% endif %}
    {% endfor %}
</div>

{% endblock %}